rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Расмий хат файллари — туман/шаҳар ходимлари юклайди,
    // тизимга кирган фойдаланувчилар кўради. Ўчириш тақиқланган.
    match /proposalLetters/{proposalId}/{fileName} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if false;
    }

    // Бошқа барча йўллар — ёпиқ
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
