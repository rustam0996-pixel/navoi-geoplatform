rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'admin'
        && userDoc().status == 'active';
    }

    // Фойдаланувчи профиллари — паролсиз (пароллар Firebase Auth'да)
    match /users/{uid} {
      allow read:   if signedIn() && (request.auth.uid == uid || isAdmin());
      // create: админ ходим қўшади ЁКИ фойдаланувчи ўз профилини яратади
      // (биринчи админни созлаш учун). update/delete: фақат админ.
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update, delete: if isAdmin();
    }

    // Ер участкаси таклифлари
    match /proposals/{id} {
      allow read:   if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Сайт бўйича таклиф ва шикоятлар
    match /feedback/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isAdmin();
    }
  }
}
